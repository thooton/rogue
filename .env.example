# Copy to .env and edit. Every setting here is provisioning only: it is applied
# on the first start and then ignored, because the agent owns its configuration
# from that point on. Set ROGUE_REPROVISION=1 to apply it again on a restart.

# ---------------------------------------------------------------- model route
# The provider ID, the model, and the key for the primary route. The default is
# a free OpenCode model, which needs no key, so an unedited copy of this file
# produces a working agent. Omit ROGUE_MODEL to take the provider's first
# credential-available model.
ROGUE_PROVIDER=opencode
ROGUE_MODEL=big-pickle
ROGUE_API_KEY=

# Paid routes look like this instead:
# ROGUE_PROVIDER=anthropic
# ROGUE_MODEL=claude-sonnet-4-6
# ROGUE_API_KEY=sk-ant-...

# Optional second route, used automatically when the first one fails on credit,
# quota, billing, authentication, availability, timeout, or network errors.
ROGUE_FALLBACK_PROVIDER=
ROGUE_FALLBACK_MODEL=
ROGUE_FALLBACK_API_KEY=

# ------------------------------------------------- local or custom endpoint
# Any OpenAI- or Anthropic-compatible server, including one on the host. Name
# the same ID in ROGUE_PROVIDER (or ROGUE_FALLBACK_PROVIDER) to route to it.
ROGUE_CUSTOM_PROVIDER_ID=
ROGUE_CUSTOM_PROVIDER_URL=
ROGUE_CUSTOM_PROVIDER_NAME=
# openai-completions | openai-responses | anthropic-messages
ROGUE_CUSTOM_PROVIDER_API=
# Must not exceed what the server was actually started with.
ROGUE_CUSTOM_PROVIDER_CONTEXT=
ROGUE_CUSTOM_PROVIDER_KEY=

# ------------------------------------------------------------------- proxy
# Stored durably and applied to provider inference, catalog discovery, and other
# outbound HTTP(S) before any route is validated. Basic auth is accepted, e.g.
# http://user:password@proxy.example:8080. SOCKS and PAC URLs are rejected.
# This does not cover the ws:// and wss:// relay connections.
ROGUE_HTTP_PROXY=
ROGUE_NO_PROXY=

# Plain HTTP_PROXY/HTTPS_PROXY/NO_PROXY are honored too, and additionally cover
# whatever the agent runs in its shell:
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# ------------------------------------------------------------------- relays
# Extra Rogue Network relays, comma- or space-separated. wss://relay.roguenetwork.org
# is always configured; these are added alongside it.
ROGUE_RELAYS=

# ------------------------------------------------------------------ runtime
# off | minimal | low | medium | high | xhigh | max
ROGUE_THINKING=
# none | short | long (default long)
ROGUE_CACHE_RETENTION=
# Stop after n wake cycles. Empty means run forever.
ROGUE_MAX_CYCLES=
# Any other rogue.js flags, split on whitespace.
ROGUE_EXTRA_ARGS=

# ------------------------------------------------------------- provisioning
# Full control: raw initial_auth.json content, or a path to a mounted file.
# Anything set above is layered on top of it.
# ROGUE_INITIAL_AUTH={"providers":[{"provider":"opencode","model":"big-pickle"}]}
# ROGUE_INITIAL_AUTH_FILE=/run/secrets/initial_auth.json

# Re-apply this file even though the container already holds a configured agent.
ROGUE_REPROVISION=0

# A paid OpenCode key. Free OpenCode models need no key.
# OPENCODE_API_KEY=
